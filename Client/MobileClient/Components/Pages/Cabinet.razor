@page "/cabinet"
@using MobileClient.Services
@using MobileClient.Components
@inject NavigationManager Navigation
@inject HttpClient httpClient
@inject IPreferencesService Preferences
@inject ICabinetService CabinetService

<div class="main">
    <div class="title">
        <p>Skills Share</p>
    </div>

    <div class="content">
        @if (user != null)
        {
            <div class="block">
                <p class="name">@user.Name @user.Surname</p>
                <p class="email">@user.Email</p>
            </div>
            @*<hr>
            <div class="block">
                <p class="skills-text">Selected skill</p>
                <div class="skills-cards">
                    @foreach (var skill in skills) 
                    {
                        <div class="skill-card">
                            <p>@skill</p>
                        </div>
                    }
                </div>
            </div> *@
            <hr>
            <div class="switch-btn">
                <label class="switch">
                    <input type="checkbox" @bind="@isAllowCookies" @bind:after="HandleInputClick">
                    <span class="slider round"></span>
                </label>
                <p>Allow using Cookies</p>
            </div>
            <button class="feedback" @onclick="() => IsShowDialog=true">Change profile information</button>
            <button class="feedback" @onclick="ToggleSupportChat">Technical Support</button>
            @if (isTeacher)
            {
                <button class="feedback" @onclick='() => Navigation.NavigateTo("/choose-skills")'>Change skills</button>
            }
            @if (!isTeacher)
            {
                <button class="feedback" @onclick="goToFeedbackPage">Leave feedback</button>
                <button class="feedback" @onclick="goToReportsPage">See reports</button>
            }
        }
        else
        {
            <p>loading...</p>
        }
            @*for debug*@
            @* <button class="feedback" @onclick="ClearPreferences">clear Preferences</button> *@
    </div>
    @if (IsShowDialog)
    {
        <div class="dialog">
            <svg @onclick="() => {IsShowDialog=false; isError=false;}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><!--!Font Awesome Free 6.5.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fonticons, Inc.--><path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/></svg>
            <input type="text" class="dialog-input" placeholder="Name" @bind="@userToChange.Name">
            <input type="text" class="dialog-input" placeholder="Surname" @bind = "@userToChange.Surname">
            <input type="text" class="dialog-input" placeholder="Email" @bind = "@userToChange.Email">
            <input type="text" class="dialog-input" placeholder="Password" @bind = "@newPassword">
            @if(isError)
            {
                <p class="error">all field must be filed in</p>              
            }
            <button class="next-btn" @onclick="ChangeInfo">
                Change
            </button>
        </div>
    }

    <SupportChat IsVisible="isSupportChatVisible" OnClose="ToggleSupportChat" />
</div>

@code {
    private User? user;
    private User userToChange = new User
    {
        Id = "",
        Name = "",
        Surname = "",
        Email = "",
        PasswordHash = "",
        Role = ""
    };
    private String newPassword = "";
    private string[] skills = {"Python", "Java", "C#", "HTML", "C++"};
    private bool IsShowDialog = false;
    private bool isTeacher;
    private bool isError = false;
    private bool isAllowCookies = false;

    // Support Chat State
    private bool isSupportChatVisible = false;

    protected override async Task OnInitializedAsync()
    {
        user = await CabinetService.GetUser();
        if (user != null)
        {
            userToChange.Name = user.Name;
            userToChange.Surname = user.Surname;
            userToChange.Email = user.Email;
            userToChange.PasswordHash = user.PasswordHash;
        }
        if (Preferences.Get("allowCookies", string.Empty) == "true")
        {
            isAllowCookies = true;
        }
        StateHasChanged(); // Removed an unnecessary StateHasChanged here. OnInitializedAsync handles this.
        isTeacher = (Preferences.Get("userRole", string.Empty) == "Teacher"); // Simplified boolean assignment
    }

    private void goToFeedbackPage() {
        Navigation.NavigateTo("/feedback");
    }

    private void goToReportsPage()
    {
        Navigation.NavigateTo("/reports");
    }

    //for debug
    private void ClearPreferences()
    {
        Preferences.Clear();
        Console.WriteLine("Cleared Preferences");
    }

    private async Task ChangeInfo() {
        if (string.IsNullOrWhiteSpace(userToChange.Name) || string.IsNullOrWhiteSpace(userToChange.Surname) || string.IsNullOrWhiteSpace(userToChange.Email) || string.IsNullOrWhiteSpace(newPassword))
        {
            isError = true;
        }
        else if (await CabinetService.ChangeInfo(userToChange, newPassword))
        {
            IsShowDialog = false;
            isError = false;
            // Optionally, refresh user data if it changed
            user = await CabinetService.GetUser(); 
            StateHasChanged();
        }
        else
        {
            // Handle failure to change info, maybe show a different error
            isError = true; // Or a more specific error message
        }
    }

    private async Task HandleInputClick() // Renamed for clarity, though @bind:after doesn't call this parameter directly.
    {
        // The @bind handles the update, this is for additional logic after change.
        Preferences.Set("allowCookies", isAllowCookies ? "true" : "false");
    }

    private void ToggleSupportChat()
    {
        isSupportChatVisible = !isSupportChatVisible;
        StateHasChanged();
    }
}