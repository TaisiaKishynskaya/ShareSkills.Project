@page "/cabinet"
@using MobileClient.Services
@using Microsoft.Extensions.Localization
@inject NavigationManager Navigation
@inject HttpClient httpClient
@inject IPreferencesService Preferences
@inject ICabinetService CabinetService
@inject ILanguageService LanguageService
@inject IStringLocalizer<SharedResource> Localizer

<div class="main">
    <div class="title">
        <p>@Localizer["AppName"]</p>
    </div>

    <div class="content">
        @if (user != null)
        {
            <div class="block">
                <p class="name">@user.Name @user.Surname</p>
                <p class="email">@user.Email</p>
            </div>
            <hr>
            <div class="switch-btn">
                <label class="switch">
                    <input type="checkbox" @bind="@isAllowCookies" @bind:after="HandleInputClick">
                    <span class="slider round"></span>
                </label>
                <p>@Localizer["AllowCookies"]</p>
            </div>
            <div class="language-selector">
                <p>@Localizer["Language"]</p>
                <select @onchange="ChangeLanguage">
                    @foreach (var lang in LanguageService.GetAvailableLanguages())
                    {
                        <option value="@lang.CultureCode" selected="@(lang.CultureCode == currentLanguage)">@lang.DisplayName</option>
                    }
                </select>
            </div>
            <button class="feedback" @onclick="() => IsShowDialog=true">@Localizer["ChangeProfileInfo"]</button>
            <button class="feedback" @onclick="NavigateToSupport">@Localizer["TechnicalSupport"]</button>
            @if (isTeacher)
            {
                <button class="feedback" @onclick='() => Navigation.NavigateTo("/choose-skills")'>@Localizer["ChangeSkills"]</button>
            }
            @if (!isTeacher)
            {
                <button class="feedback" @onclick="goToFeedbackPage">@Localizer["LeaveFeedback"]</button>
                <button class="feedback" @onclick="goToReportsPage">@Localizer["SeeReports"]</button>
            }
        }
        else
        {
            <p>@Localizer["Loading"]</p>
        }
    </div>
    @if (IsShowDialog)
    {
        <div class="dialog">
            <svg @onclick="() => {IsShowDialog=false; isError=false;}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><!--!Font Awesome Free 6.5.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fonticons, Inc.--><path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z" /></svg>
            <input type="text" class="dialog-input" placeholder="@Localizer["Name"]" @bind="@userToChange.Name">
            <input type="text" class="dialog-input" placeholder="@Localizer["Surname"]" @bind="@userToChange.Surname">
            <input type="text" class="dialog-input" placeholder="@Localizer["Email"]" @bind="@userToChange.Email">
            <input type="text" class="dialog-input" placeholder="@Localizer["Password"]" @bind="@newPassword">
            @if (isError)
            {
                <p class="error">@Localizer["AllFieldsRequired"]</p>
            }
            <button class="next-btn" @onclick="ChangeInfo">
                @Localizer["Change"]
            </button>
        </div>
    }
</div>

@code {
    private User? user;
    private User userToChange = new User
        {
            Id = "",
            Name = "",
            Surname = "",
            Email = "",
            PasswordHash = "",
            Role = ""
        };
    private String newPassword = "";
    private bool IsShowDialog = false;
    private bool isTeacher;
    private bool isError = false;
    private bool isAllowCookies = false;
    private string currentLanguage;

    protected override async Task OnInitializedAsync()
    {
        user = await CabinetService.GetUser();
        if (user != null)
        {
            userToChange.Name = user.Name;
            userToChange.Surname = user.Surname;
            userToChange.Email = user.Email;
            userToChange.PasswordHash = user.PasswordHash;
        }
        if (Preferences.Get("allowCookies", string.Empty) == "true")
        {
            isAllowCookies = true;
        }
        isTeacher = (Preferences.Get("userRole", string.Empty) == "Teacher");
        LanguageService.InitializeLanguageAsync();
        currentLanguage = LanguageService.GetCurrentLanguage();
    }

    private async Task ChangeLanguage(ChangeEventArgs e)
    {
        string newLanguage = e.Value.ToString();
        if (newLanguage != currentLanguage)
        {
            await LanguageService.SetLanguageAsync(newLanguage);
            currentLanguage = newLanguage;
            // Reload the page to apply new language
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
    }

    private void goToFeedbackPage()
    {
        Navigation.NavigateTo("/feedback");
    }

    private void goToReportsPage()
    {
        Navigation.NavigateTo("/reports");
    }

    private void NavigateToSupport()
    {
        Navigation.NavigateTo("/support");
    }

    private async Task ChangeInfo()
    {
        if (string.IsNullOrWhiteSpace(userToChange.Name) || string.IsNullOrWhiteSpace(userToChange.Surname) || string.IsNullOrWhiteSpace(userToChange.Email) || string.IsNullOrWhiteSpace(newPassword))
        {
            isError = true;
        }
        else if (await CabinetService.ChangeInfo(userToChange, newPassword))
        {
            IsShowDialog = false;
            isError = false;
            // Optionally, refresh user data if it changed
            user = await CabinetService.GetUser();
            StateHasChanged();
        }
        else
        {
            // Handle failure to change info, maybe show a different error
            isError = true; // Or a more specific error message
        }
    }

    private async Task HandleInputClick()
    {
        Preferences.Set("allowCookies", isAllowCookies ? "true" : "false");
    }
}