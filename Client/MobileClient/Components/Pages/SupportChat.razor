@using MobileClient.Services
@inject ITechnicalSupportService TechnicalSupportService
@inject IJSRuntime JSRuntime

@if (IsVisible)
{
    <div class="support-chat-popup-overlay" @onclick="HandleOverlayClick">
        <div class="support-chat-popup" @onclick:stopPropagation="true">
            <div class="support-chat-header">
                <span>Support Chat</span>
                <svg @onclick="CloseChat" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512" class="close-icon"><!--!Font Awesome Free 6.5.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fonticons, Inc.--><path fill="currentColor" d="M342.6 150.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L192 210.7 86.6 105.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L146.7 256 41.4 361.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192 301.3 297.4 406.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L237.3 256 342.6 150.6z" /></svg>
            </div>
            <div class="support-chat-messages-container" @ref="messagesContainer">
                @if (isLoadingHistory)
                {
                    <div class="loading-history">Loading chat history...</div>
                }
                else
                {
                    @foreach (var msg in messages.OrderBy(m => m.Timestamp))
                    {
                        <div class="support-chat-message @(msg.IsUserMessage ? "user-message" : "support-message")">
                            <p>@msg.Text</p>
                            <span class="message-timestamp">@msg.Timestamp.ToString("hh:mm tt")</span>
                        </div>
                    }
                }
            </div>
            <div class="support-chat-input-area">
                <input type="text" class="support-chat-input" placeholder="Type your message..." @bind="currentMessage" @bind:event="oninput" @onkeyup="HandleInputKeyUp" />
                <button class="support-chat-send-btn" @onclick="SendMessageAsync" disabled="@(isSending || string.IsNullOrWhiteSpace(currentMessage))">
                    @if (isSending)
                    {
                        <span class="spinner"></span> <!-- Basic spinner, can be improved -->
                    }
                    else
                    {
                        <span>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><!--!Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.--><path d="M498.1 5.6c10.1 7 15.4 19.1 13.5 31.2l-64 416c-1.5 9.7-7.4 18.2-16 23s-18.9 5.4-28 1.6L284 427.7l-68.5 74.1c-8.9 9.7-22.9 12.9-35.2 8.1S160 493.2 160 480l0-83.6c0-4 1.5-7.8 4.2-10.8L331.8 202.8c5.8-6.3 5.6-16-.4-22s-15.7-6.4-22-.7L106 360.8 17.7 316.6C7.1 311.3 .3 300.7 0 288.9s5.9-22.8 16.1-28.7l448-256c10.7-6.1 23.9-5.5 34 1.4z" /></svg>
                        </span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string currentMessage = "";
    private List<ChatMessage> messages = new List<ChatMessage>();
    private bool isLoadingHistory = false;
    private bool isSending = false;
    private ElementReference messagesContainer;

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && !messages.Any() && !isLoadingHistory)
        {
            await LoadChatHistory();
        }
    }

    private async Task LoadChatHistory()
    {
        isLoadingHistory = true;
        StateHasChanged(); // Update UI to show loading indicator
        var history = await TechnicalSupportService.GetChatHistoryAsync();
        messages.AddRange(history);
        isLoadingHistory = false;
        StateHasChanged(); // Update UI with loaded messages
        await ScrollToBottom();
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(currentMessage) || isSending) return;

        isSending = true;
        StateHasChanged();

        var messageText = currentMessage;
        var userMessage = new ChatMessage(messageText, true, DateTime.Now);
        messages.Add(userMessage);
        currentMessage = ""; // Clear input immediately

        // Optimistically update UI
        StateHasChanged();
        await ScrollToBottom();

        await TechnicalSupportService.SendMessageAsync(messageText);
        // In a real app, you might get a response or confirmation here.
        // For now, we just simulate a response after a delay.
        await Task.Delay(1000); // Simulate support agent typing
        messages.Add(new ChatMessage("Thanks for your message. An agent will be with you shortly.", false, DateTime.Now));

        isSending = false;
        StateHasChanged();
        await ScrollToBottom();
    }

    private async Task HandleInputKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(currentMessage) && !isSending)
        {
            await SendMessageAsync();
        }
    }

    private async Task CloseChat()
    {
        await OnClose.InvokeAsync();
    }

    private async Task HandleOverlayClick()
    {
        await CloseChat();
    }

    private async Task ScrollToBottom()
    {
        // Wait for the DOM to update before scrolling
        await Task.Delay(50); // Small delay to ensure elements are rendered
        if (IsVisible) // Only scroll if the chat is visible
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("scrollToBottom", messagesContainer);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error scrolling to bottom: {ex.Message}");
            }
        }
    }

    // JavaScript interop function to scroll the chat
    // This should be placed in _Host.cshtml or a global JS file
    // For MAUI Blazor, it's better to place it in wwwroot/index.html or a linked JS file.
    // Let's assume for now it's in wwwroot/js/chat.js
    // And wwwroot/index.html includes <script src="js/chat.js"></script>
}