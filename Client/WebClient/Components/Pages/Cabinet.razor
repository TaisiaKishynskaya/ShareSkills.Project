@page "/cabinet"
@using WebClient.Services
@inject NavigationManager Navigation
@inject HttpClient httpClient
@inject ICabinetService CabinetService
@inject IJSRuntime JSRuntime

<div class="main">
    <div class="title">
        <p>Skills Share</p>
    </div>

    <div class="content">
        @if (user != null)
        {
            <div class="block">
                <p class="name">@user.Name @user.Surname</p>
                <p class="email">@user.Email</p>
            </div>
            <hr>
            <div class="switch-btn">
                <label class="switch">
                    <input type="checkbox" @bind="@isAllowCookies" @bind:after="HandleCookiesPreferenceChange">
                    <span class="slider round"></span>
                </label>
                <p>Allow using Cookies</p>
            </div>
            <button class="feedback" @onclick="() => IsShowDialog = true">Change profile information</button>
            <button class="feedback" @onclick="NavigateToSupport">Technical Support</button>
            @if (isTeacher)
            {
                <button class="feedback" @onclick='() => Navigation.NavigateTo("/chooseSkills")'>Change skills</button>
            }

            @if (!isTeacher)
            {
                <button class="feedback" @onclick="goToFeedbackPage">Leave feedback</button>
                <button class="feedback" @onclick="goToReportsPage">See reports</button>
            }
        }
        else
        {
            <p>loading...</p>
        }
    </div>
    @if (IsShowDialog)
    {
        <div class="dialog">
            <svg @onclick="() => { IsShowDialog = false; ErrorMessage = string.Empty; }" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
                <path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z" />
            </svg>
            <input type="text" class="dialog-input" placeholder="Name" @bind="@userToChange.Name">
            <input type="text" class="dialog-input" placeholder="Surname" @bind="@userToChange.Surname">
            <input type="text" class="dialog-input" placeholder="Email" @bind="@userToChange.Email">
            <input type="text" class="dialog-input" placeholder="Password" @bind="@newPassword">
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <p class="error">@ErrorMessage</p>
            }
            <button class="next-btn" @onclick="ChangeInfo">
                Change
            </button>
        </div>
    }
</div>

@code {
    private User? user; // Nullable User

    private User userToChange = new User
        {
            Id = "",
            Name = "",
            Surname = "",
            Email = "",
            PasswordHash = "",
            Role = "",
        };

    private String newPassword = "";
    private string[] skills = { "Python", "Java", "C#", "HTML", "C++" };
    private bool IsShowDialog = false;
    private bool isTeacher;
    private string ErrorMessage = "";
    private bool isAllowCookies = false;

    protected override async Task OnInitializedAsync()
    {
        user = await CabinetService.GetUser();
        if (user != null)
        {
            userToChange.Name = user.Name;
            userToChange.Surname = user.Surname;
            userToChange.Email = user.Email;
            userToChange.PasswordHash = user.PasswordHash; // Assuming this is okay to copy for change purposes
        }

        var allowCookiesPreference = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "allowCookies");
        isAllowCookies = allowCookiesPreference == "true";

        var userRolePreference = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userRole");
        isTeacher = userRolePreference == "Teacher";
    }

    private void goToFeedbackPage()
    {
        Navigation.NavigateTo("/feedback");
    }

    private void goToReportsPage()
    {
        Navigation.NavigateTo("/reports");
    }

    private void NavigateToSupport()
    {
        Navigation.NavigateTo("/support");
    }

    private async Task ChangeInfo()
    {
        if (string.IsNullOrWhiteSpace(userToChange.Name) ||
            string.IsNullOrWhiteSpace(userToChange.Surname) ||
            string.IsNullOrWhiteSpace(userToChange.Email) ||
            string.IsNullOrWhiteSpace(newPassword))
        {
            ErrorMessage = "All fields must be filled in.";
            return;
        }

        ErrorMessage = ""; // Clear previous error

        // Assuming CabinetService.ChangeInfo returns a tuple (bool success, string? errorMessage)
        var (success, serviceErrorMessage) = await CabinetService.ChangeInfo(userToChange, newPassword);
        if (success)
        {
            IsShowDialog = false;
            // Optionally, refresh user data from service
            user = await CabinetService.GetUser();
            if (user != null) // Update userToChange as well if dialog might reopen with old data
            {
                userToChange.Name = user.Name;
                userToChange.Surname = user.Surname;
                userToChange.Email = user.Email;
            }
            StateHasChanged();
        }
        else
        {
            ErrorMessage = serviceErrorMessage ?? "Failed to update profile. Please try again.";
        }
    }

    // Renamed from HandleInputClick for clarity as it's specifically for cookies
    private async Task HandleCookiesPreferenceChange()
    {
        // isAllowCookies is already bound and updated. This method runs after the update.
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "allowCookies", isAllowCookies ? "true" : "false");
    }
}