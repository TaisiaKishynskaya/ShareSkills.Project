@page "/support"
@using WebClient.Services
@using WebClient.Components.Layout
@inject ITechnicalSupportService TechnicalSupportService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@layout NoMenuLayout

<div class="main">
    <div class="header">
        <svg @onclick="NavigateBack" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" class="back-icon">
            <path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z" />
        </svg>
        <h1>Technical Support</h1>
    </div>

    <div class="chat-container">
        <div class="messages-container" @ref="messagesContainer">
            @if (isLoadingHistory)
            {
                <div class="loading-history">Loading chat history...</div>
            }
            else
            {
                @foreach (var msg in messages.OrderBy(m => m.Timestamp))
                {
                    <div class="chat-message @(msg.IsUserMessage ? "user-message" : "support-message")">
                        <p>@msg.Text</p>
                        <span class="message-timestamp">@msg.Timestamp.ToString("hh:mm tt")</span>
                    </div>
                }
            }
        </div>

        <div class="input-area">
            <input type="text" class="chat-input" placeholder="Type your message..." @bind="currentMessage" @bind:event="oninput" @onkeyup="HandleInputKeyUp" />
            <button class="send-btn" @onclick="SendMessageAsync" disabled="@(isSending || string.IsNullOrWhiteSpace(currentMessage))">
                @if (isSending)
                {
                    <span class="spinner"></span>
                }
                else
                {
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                            <path d="M498.1 5.6c10.1 7 15.4 19.1 13.5 31.2l-64 416c-1.5 9.7-7.4 18.2-16 23s-18.9 5.4-28 1.6L284 427.7l-68.5 74.1c-8.9 9.7-22.9 12.9-35.2 8.1S160 493.2 160 480l0-83.6c0-4 1.5-7.8 4.2-10.8L331.8 202.8c5.8-6.3 5.6-16-.4-22s-15.7-6.4-22-.7L106 360.8 17.7 316.6C7.1 311.3 .3 300.7 0 288.9s5.9-22.8 16.1-28.7l448-256c10.7-6.1 23.9-5.5 34 1.4z" />
                        </svg>
                    </span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    private string currentMessage = "";
    private List<ChatMessage> messages = new List<ChatMessage>();
    private bool isLoadingHistory = false;
    private bool isSending = false;
    private ElementReference messagesContainer;

    protected override async Task OnInitializedAsync()
    {
        await LoadChatHistory();
    }

    private async Task LoadChatHistory()
    {
        isLoadingHistory = true;
        StateHasChanged();
        var history = await TechnicalSupportService.GetChatHistoryAsync();
        messages = new List<ChatMessage>(history);
        isLoadingHistory = false;
        StateHasChanged();
        await ScrollToBottom();
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(currentMessage) || isSending) return;

        isSending = true;
        StateHasChanged();

        var messageText = currentMessage;
        currentMessage = ""; // Clear input immediately

        // Add user message to UI
        var userMessage = new ChatMessage(messageText, true, DateTime.Now);
        messages.Add(userMessage);
        StateHasChanged();
        await ScrollToBottom();

        // Add "waiting for response" message
        var waitingMessage = new ChatMessage("Waiting for response...", false, DateTime.Now);
        messages.Add(waitingMessage);
        StateHasChanged();
        await ScrollToBottom();

        // Send message to service (this will add user's message to history and make API call)
        await TechnicalSupportService.SendMessageAsync(messageText);

        // Get updated chat history (which now includes the API response)
        var updatedHistory = await TechnicalSupportService.GetChatHistoryAsync();

        // Replace our local messages list (removing the "waiting" message)
        messages = updatedHistory;

        isSending = false;
        StateHasChanged();
        await ScrollToBottom();
    }

    private async Task HandleInputKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(currentMessage) && !isSending)
        {
            await SendMessageAsync();
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo(Navigation.Uri.Contains("/cabinet") ? "/cabinet" : "/");
    }

    private async Task ScrollToBottom()
    {
        await Task.Delay(50);
        try
        {
            await JSRuntime.InvokeVoidAsync("scrollToBottom", messagesContainer);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error scrolling to bottom: {ex.Message}");
        }
    }
}