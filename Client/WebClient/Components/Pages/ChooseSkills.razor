@page "/chooseSkills"
@using WebClient.Components.Layout
@using WebClient.Services
@using Microsoft.Extensions.Localization
@layout NoMenuLayout
@inject NavigationManager Navigation
@inject HttpClient httpClient
@inject IAuthService AuthService
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SharedResource> Localizer

<div class="main">
    @if (skills != null)
    {
        <h3 class="first">@Localizer["ChooseSkills"]</h3>
        <div class="skills">
            @foreach (var skill in skills)
            {
                <div class="skill-check-container">
                    <input class="skill-check" type="radio" name="skill" @onchange="@(() => choosedSkill = @skill.skill)">
                    <p>@skill.skill</p>
                </div>
            }
        </div>
        @if (isTeacher)
        {
            <hr>
            <h3>@Localizer["ChooseTime"]</h3>
            <div class="lesson-time">
                <div class="elem">
                    <label for="time">@Localizer["Morning"]</label>
                    <input type="radio" name="time" id="morning" @onchange="@(() => Time = "morning")">
                </div>
                <div class="elem">
                    <label for="time">@Localizer["Day"]</label>
                    <input type="radio" name="time" id="day" @onchange="@(() => Time = "day")">
                </div>
                <div class="elem">
                    <label for="time">@Localizer["Evening"]</label>
                    <input type="radio" name="time" id="evening" @onchange="@(() => Time = "evening")">
                </div>
            </div>
            <hr>
            <h3>@Localizer["SelectLevel"]</h3>
            <div class="level">
                <div class="elem">
                    <label for="level">@Localizer["Introductory"]</label>
                    <input type="radio" name="level" id="introductory" @onchange="@(() => Level = "introductory")">
                </div>
                <div class="elem">
                    <label for="level">@Localizer["Intermediate"]</label>
                    <input type="radio" name="level" id="intermidiate" @onchange="@(() => Level = "intermidiate")">
                </div>
                <div class="elem">
                    <label for="level">@Localizer["Advanced"]</label>
                    <input type="radio" name="level" id="advanced" @onchange="@(() => Level = "advanced")">
                </div>
            </div>
        }
    }
    <button @onclick="calendarNavigate">@Localizer["Next"]</button>
    @if (IsError)
    {
        <p class="error">@Localizer["Error"]</p>
    }

</div>

@code {

    private async Task calendarNavigate()
    {
        var userId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
        if (await AuthService.ChangeSkills(userId, choosedSkill, Time, Level))
        {
            IsError = false;
            Console.WriteLine($"{choosedSkill}, {Time}, {Level}");
            Navigation.NavigateTo("/calendar");
        }
        else
        {
            IsError = true;
        }
    }

    List<Skill> skills;
    String choosedSkill;
    String Time;
    String Level;
    bool isTeacher;
    bool IsError = false;


    protected override async Task OnInitializedAsync()
    {
        skills = await AuthService.GetSkills();
        await AuthService.GetUserRole();
        isTeacher = (await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userRole") == "Teacher") ? true : false;
    }

}