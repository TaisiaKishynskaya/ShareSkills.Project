@page "/reports"
@using WebClient.Services
@inject NavigationManager Navigation
@inject IReportsService ReportService

<div class="main">
    <div class="title">
        <svg @onclick="goToCabinet" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
            <!--!Font Awesome Free 6.7.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fonticons, Inc.--><path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/>
        </svg>
        <p class="reports-text">Available reports</p>
    </div>
    @if (reports.Any() && reports != null)
    {
        <div class="buttons">
            @foreach (var report in reports)
            {
                var index = reports.IndexOf(report);
                <button @onclick="() => showReport(index)">@report.skillName</button>
            }
        </div>
    }
    else
    {
        <p>No available reports yet</p>
    }
    @if (isReportDialog && report != null)
    {
        <div class="report">
            <div class="title">
                <svg @onclick="() => isReportDialog = false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
                    <!--!Font Awesome Free 6.7.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fonticons, Inc.--><path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/>
                </svg>
                <h2>Share Skills</h2>
            </div>
            <h1>@report.studentName @report.studentSurname</h1>
            <p>report from: @report.teacherName @report.teacherSurname</p>
            <p>subject: @report.skillName</p>
            <hr>
            <div class="info">
                <div class="block">
                    <p class="metric">Learning time:</p>
                    <p>@report.totalTime</p>
                </div>
                <hr>
                <div class="block">
                    <p class="metric">Learned topics:</p>
                    <p>@themesList</p>
                </div>
                @* <hr> *@
                @* <div class="block"> *@
                @*     <p class="metric">Teacher`s grade:</p> *@
                @*     <div class="star"> *@
                @*         <p>5/5</p> *@
                @*         <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512"><!--!Font Awesome Free 6.6.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fonticons, Inc.--><path d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z"/></svg> *@
                @*     </div> *@
                @* </div> *@
            </div>
        </div>
    }
</div>

@code {
    List<Report> reports = new List<Report> { };
    Report report;
    String themesList;
    bool isReportDialog = false;

    protected override async Task OnInitializedAsync()
    {
        reports = await ReportService.getReports();
    }

    async Task showReport(int index)
    {
        report = reports[index];
        themesList = "";
        foreach (var theme in report.themes)
        {
            themesList += $"{theme}, ";
        }

        themesList = themesList.Remove(themesList.Length - 2);
        isReportDialog = true;
    }

    async Task goToCabinet()
    {
        Navigation.NavigateTo("/cabinet");
    }

}
